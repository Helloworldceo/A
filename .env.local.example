# Copy this file to .env.local and fill in real values for local development.
# In production, set these as Vercel Environment Variables instead
# (Project Settings -> Environment Variables) -- never commit real secrets.

# DeepSeek API key -- used by LoadExtractionAgent and AIAnalysisAgent
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# OpenCage geocoding API key -- used by GeospatialAgent
OPENCAGE_API_KEY=

# Global Solar Atlas base URL -- used by PVDataAgent
GLOBAL_SOLAR_ATLAS_BASE_URL=

# Shared password gate for the /api/analyze endpoint.
# Leave unset to disable the gate (not recommended for a public deployment).
APP_PASSWORD=
